<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========== 普通权限：第三方 App 也能拿 ========== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 语音待命时由前台服务托管麦克风生命周期；只能在用户可见时启动。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 12+ 精确闹钟：后台启动 Activity 的 AlarmManager 路径 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 端侧语音识别需要自己持有麦克风（AudioRecord），系统 SpeechRecognizer 会被抢占 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 沙箱挂载目录：SAF 选目录需要存储读权限；
         MANAGE_EXTERNAL_STORAGE 让 proot 能 bind 共享存储下的目录。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- ========== 系统能力直调：音量 / 亮度 / 电话 / 联系人 ========== -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- 调屏幕亮度；特殊权限，需要用户在系统设置里手动开启（会拉起授权页引导） -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 本地音乐库 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- ========== 系统级权限：仅自研 ROM（平台签名 + priv-app 白名单）可授予 ==========
         这些权限在普通设备上声明了也拿不到，只在 /system/priv-app 下 + 平台签名时生效。
         白名单见 rom/privapp-permissions-com.pilot.agent.xml -->

    <!-- 当 AppFunctions 的调用方：读全系统工具表 -->
    <uses-permission android:name="android.permission.EXECUTE_APP_FUNCTIONS"
        tools:ignore="ProtectedPermissions" />
    <!-- 发起 Computer Control 会话：后台虚拟屏跑目标 App -->
    <uses-permission android:name="android.permission.ACCESS_COMPUTER_CONTROL"
        tools:ignore="ProtectedPermissions" />
    <!-- 绕过无障碍直接注入输入事件（比 dispatchGesture 更底层、更可靠） -->
    <uses-permission android:name="android.permission.INJECT_EVENTS"
        tools:ignore="ProtectedPermissions" />
    <!-- 改系统设置：默认助理、无障碍开关、勿扰等 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.STATUS_BAR"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS"
        tools:ignore="ProtectedPermissions" />
    <!-- 抓系统音频（语音唤醒/通话场景用，可按需删） -->
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".PilotApp"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/ic_pilot"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pilot">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 长按 Home / 电源唤起。ROM 里把 config_defaultAssistant 指到它，
             就能像系统助理一样被系统键唤起。 -->
        <activity
            android:name=".ui.AssistActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Pilot.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.AgentAccessibilityService"
            android:exported="true"
            android:label="@string/agent_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_accessibility" />
        </service>

        <!-- 用户必须在系统的“通知使用权”页面显式开启；Pilot 不保存通知正文到磁盘。 -->
        <service
            android:name=".service.NotificationListener"
            android:exported="true"
            android:label="Pilot 通知读取"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification"
                android:resource="@xml/notification_listener" />
        </service>

        <!-- 常驻前台服务：后台起 Activity 的通行证（HarmonyOS 会拦 BOUND_FOREGROUND_SERVICE） -->
        <service
            android:name=".service.PilotForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="voice_assistant_background_activity_launch" />
        </service>

        <!-- 透明代理 Activity：绕过 HarmonyOS 后台启动 Activity 拦截（见 ForegroundProxyActivity） -->
        <activity
            android:name=".ui.ForegroundProxyActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 高德 Key：绑定包名（com.pilot.agent），从 local.properties 注入 -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_KEY}" />

        <!--
          高德定位的辅助服务。高德 navi SDK 是纯 jar（不是 aar），
          它的 manifest 不会被合并，而 AMapLocationClient 启动时会拉起这个服务。
          不声明就会在 logcat 看到
            Unable to start service Intent { cmp=.../com.amap.api.location.APSService } not found
          并导致定位能力退化。必须手动补上（nav-agent 同款，已踩过）。
        -->
        <service
            android:name="com.amap.api.location.APSService"
            android:enabled="true"
            android:exported="false" />

        <!-- 触发入口：am start 走 Activity 而不是广播（华为 ROM 的广播队列会卡死） -->
        <activity
            android:name=".ui.TriggerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 导航界面：高德 AMapNaviView 的载体（引擎必须有 View 才会回调） -->
        <!--
          导航界面：必须在 :navigation 进程！
          NavigationService 的定位器是**进程内静态引用**，
          跨进程拿不到（实测：Activity 在主进程时 peekLocationProvider 返回 null，
          地图就停在北京市不动）。
        -->
        <activity
            android:name="com.pilot.navigation.NavActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTop"
            android:process=":navigation"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- 导航服务：独立进程（高德 native 87MB，崩溃隔离 + 内存独立计量） -->
        <service
            android:name="com.pilot.navigation.NavigationService"
            android:exported="false"
            android:process=":navigation" />

        <!-- 沙箱独立进程（崩溃隔离 + 内存独立计量，见 SandboxService 头注释） -->
        <service
            android:name=".sandbox.SandboxService"
            android:exported="false"
            android:process=":sandbox" />

        <!-- Go tsnet node is loaded only for remote music API calls; process can be reclaimed. -->
        <service
            android:name=".music.TailscaleNodeService"
            android:exported="false"
            android:process=":tailscale" />

        <!-- 后台触发入口：语音、系统键、外部程序通过它唤起 agent，不需要 agent 自己的界面在前台 -->
        <receiver
            android:name=".service.RunReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pilot.agent.RUN" />
            </intent-filter>
        </receiver>

        <receiver android:name=".action.ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.pilot.agent.REMINDER_FIRE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
